# NAS 图片服务配置示例
# 用法：cp .env.example .env 后按注释修改。docker compose 会自动读取同目录 .env。

# ① 强随机密钥：必须与 EdgeOne 的 NAS_API_TOKEN 完全一致。
#    生成方法见教程：openssl rand -hex 24
NAS_API_TOKEN=change-me-to-a-long-random-secret

# ② 图片对外公网 HTTPS 地址（不带结尾斜杠）。
#    反代暴露 /images/* 用的域名，例如 https://pic.example.com
PUBLIC_BASE_URL=https://pic.example.com

# ③ 容器内监听端口（一般不用改）
PORT=3000

# ④ 图片在 NAS 上的真实存放目录（改成你自己的路径）。
#    群晖示例 /volume1/docker/eop-images；威联通 /share/...；绿联/极空间按实际填。
IMAGE_DIR=/volume1/docker/eop-images

# ⑤ 图片清单内存缓存时间（毫秒），默认 30 秒
MANIFEST_TTL_MS=30000
