# ===== EdgeOne Pages 环境变量示例 =====
# 复制为 .env.local 用于本地开发，线上在 EdgeOne Pages 控制台配置同名变量。

# 管理后台密码（不配置则使用默认值 admin123，线上务必修改）
ADMIN_PASSWORD=change-me-admin-password

# NAS 图片服务的内网/公网 API 地址（不含结尾斜杠）
# EdgeOne 云端函数需要能访问到这个地址；若 NAS 在公网，填 https://pic-api.example.com
NAS_API_URL=https://pic-api.example.com

# NAS 服务的 API 密钥，必须与 nas-service/.env 里的 NAS_API_TOKEN 完全一致
NAS_API_TOKEN=change-me-to-a-long-random-secret

# 图片对外访问的公网地址（不含结尾斜杠）。
# 前端页面 / 随机 API 会返回 `${NEXT_PUBLIC_IMAGE_BASE_URL}/images/xxx`。
# 留空则使用本站同源代理 /api/images?name=xxx（会经过 EdgeOne CDN，但消耗边缘函数流量）。
NEXT_PUBLIC_IMAGE_BASE_URL=https://pic.example.com

# 图库 /gallery 访问密码（可选）。
# 设置后，访客打开图库需输入密码；不设置则图库公开访问。
# 后台 /admin 仍使用上面的 ADMIN_PASSWORD。
GALLERY_PASSWORD=change-me-gallery-password
